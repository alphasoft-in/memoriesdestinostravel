---
import SEO from '../components/SEO.astro';
import '../styles/global.css';
import Navbar from '../components/Navbar.jsx';
import Footer from '../components/Footer.jsx';
import Destinations from '../components/Destinations.jsx';
---

<html lang="es" class="scroll-smooth">
	<head>
		<SEO title="Destinos - Memories Destinos Travel Agency" description="Descubre los mejores destinos turísticos con Memories Destinos Travel Agency." />
	</head>
	<body class="bg-white antialiased font-sans flex flex-col min-h-screen">
		<Navbar client:load forceSolid={true} />
		<main class="flex-grow pt-24">
			<Destinations client:visible />
		</main>
        <Footer client:visible />
	</body>
</html>
