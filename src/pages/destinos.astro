---
import SEO from '../components/SEO.astro';
import '../styles/global.css';
import Navbar from '../components/Navbar.jsx';
import Footer from '../components/Footer.jsx';
import Destinations from '../components/Destinations.jsx';
---

<html lang="es" class="scroll-smooth">
	<head>
		<SEO 
			title="Paquetes Turísticos en Cusco y Perú | Memories Destinos" 
			description="Explora nuestros paquetes turísticos en Cusco: desde Full Day hasta itinerarios de 13 días. Tours a Machu Picchu, Humantay y Valle Sagrado con atención personalizada." 
		/>
	</head>
	<body class="bg-white antialiased font-sans flex flex-col min-h-screen">
		<Navbar client:load forceSolid={true} />
		<main class="flex-grow pt-24">
			<Destinations client:visible />
		</main>
        <Footer client:visible />
	</body>
</html>
