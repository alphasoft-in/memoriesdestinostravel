---
import SEO from '../components/SEO.astro';
import '../styles/global.css';
import Navbar from '../components/Navbar.jsx';
import Footer from '../components/Footer.jsx';
import Gallery from '../components/Gallery.jsx';
---

<html lang="es" class="scroll-smooth">
	<head>
		<SEO title="Galería - Memories Destinos Travel Agency" description="Descubre los mejores destinos turísticos con Memories Destinos Travel Agency." />
	</head>
	<body class="bg-white antialiased font-sans flex flex-col min-h-screen">
		<Navbar client:load forceSolid={true} />
		<main class="flex-grow pt-24 md:pt-28">
			<Gallery client:visible />
		</main>
        <Footer client:visible />
	</body>
</html>
