---
import SEO from '../components/SEO.astro';
import '../styles/global.css';
import Navbar from '../components/Navbar.jsx';
import Footer from '../components/Footer.jsx';
import Gallery from '../components/Gallery.jsx';
---

<html lang="es" class="scroll-smooth">
	<head>
		<SEO 
			title="Galería de Fotos | Experiencias en Cusco y Perú - Memories Destinos" 
			description="Revive los mejores momentos de nuestros viajeros en Machu Picchu, Laguna Humantay y los Andes. Inspírate con nuestra galería de fotos turísticas." 
		/>
	</head>
	<body class="bg-white antialiased font-sans flex flex-col min-h-screen">
		<Navbar client:load forceSolid={true} />
		<main class="flex-grow pt-24 md:pt-28">
			<Gallery client:load />
		</main>
        <Footer client:visible />
	</body>
</html>
