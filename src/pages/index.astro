---
import SEO from '../components/SEO.astro';
import '../styles/global.css';
import Navbar from '../components/Navbar.jsx';
import Hero from '../components/Hero.jsx';
import Destinations from '../components/Destinations.jsx';
import Footer from '../components/Footer.jsx';
---

<html lang="es" class="scroll-smooth">
	<head>
		<SEO 
			title="Memories Destinos | Agencia de Viajes y Tours en Cusco, Perú" 
			description="Agencia de viajes en Cusco especializada en tours a Machu Picchu, Valle Sagrado, Montaña de 7 Colores y paquetes turísticos personalizados en Perú." 
		/>
	</head>
	<body class="bg-white antialiased font-sans">
		<Navbar client:load />
		<main>
			<Hero client:load />
			<Destinations client:visible limit={6} />
		</main>
        <Footer client:visible />
	</body>
</html>
