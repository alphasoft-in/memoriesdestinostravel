---
import SEO from '../components/SEO.astro';
import '../styles/global.css';
import Navbar from '../components/Navbar.jsx';
import Hero from '../components/Hero.jsx';
import Destinations from '../components/Destinations.jsx';
import Footer from '../components/Footer.jsx';
---

<html lang="es" class="scroll-smooth">
	<head>
		<SEO title="Memories Destinos - Travel Agency" description="Descubre los mejores destinos turísticos con Memories Destinos Travel Agency. Creamos recuerdos inolvidables." />
	</head>
	<body class="bg-white antialiased font-sans">
		<Navbar client:load />
		<main>
			<Hero client:load />
			<Destinations client:visible limit={6} />
		</main>
        <Footer client:visible />
	</body>
</html>
